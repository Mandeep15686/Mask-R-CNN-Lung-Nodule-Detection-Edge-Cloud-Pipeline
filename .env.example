# ── Backend ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./lung_nodule.db
MODEL_PATH=./experiments/best_model.pth
SCORE_THRESHOLD=0.3
NMS_THRESHOLD=0.5
PATCH_SIZE=64

# ── Training ──────────────────────────────────────────────────────────────
DATA_ROOT=./data/luna16
CUDA_VISIBLE_DEVICES=0

# ── Edge Node ─────────────────────────────────────────────────────────────
CLOUD_API_URL=http://localhost:8000
NODE_ID=edge-node-01
HOSTNAME=edge-01.hospital.local
NODE_IP=192.168.1.10
SPLIT_LAYER=layer2         # layer1 | layer2 | layer3
COMPRESSION=int8           # none | int8 | learned
HEARTBEAT_SEC=30

# ── MLflow (optional) ─────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
EDGE_API_TOKEN=change-this-to-a-long-random-secret
